# =============================================================
#  LLM PROVIDERS  - you need at least ONE
# =============================================================

# Google AI Studio - FREE TIER, no card. Get a key in ~1 minute:
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic - paid, needs credits at console.anthropic.com
# NOTE: a claude.ai Pro subscription does NOT include API access.
ANTHROPIC_API_KEY=

# OpenAI - paid
OPENAI_API_KEY=

# xAI Grok - paid.  https://console.x.ai
XAI_API_KEY=

# DeepSeek - paid but very cheap, roughly 1/10th of Claude.
#   https://platform.deepseek.com
DEEPSEEK_API_KEY=

# -------------------------------------------------------------
#  ROUTING - which provider handles which job, in priority order.
#  First one with a key that works wins; the rest are failover.
#  Default (if unset): anthropic,gemini,openai
# -------------------------------------------------------------
# Free-only setup:
#   CHEAP_CHAIN=gemini
#   REASONING_CHAIN=gemini
#   CHAT_CHAIN=gemini
#
# Cheap tagging on Gemini, real reasoning on Claude:
#   CHEAP_CHAIN=gemini
#   REASONING_CHAIN=anthropic,gemini
#   CHAT_CHAIN=anthropic,gemini

CHEAP_CHAIN=
REASONING_CHAIN=
CHAT_CHAIN=

# Model overrides. Format: {PROVIDER}_{ROLE}_MODEL
# GEMINI_REASONING_MODEL=gemini-2.5-pro
# ANTHROPIC_REASONING_MODEL=claude-sonnet-5
# OPENAI_REASONING_MODEL=gpt-4o

# Council mode: every configured provider votes on each signal.
# They must agree on direction or it becomes no_trade. Costs N times more.
COUNCIL=0

# Reviewer: a DIFFERENT provider critiques each signal and can reject it,
# widen the stop, or cut confidence. One extra call per signal.
REVIEW=0
REVIEW_CHAIN=

# =============================================================
#  MARKET DATA  - all optional, falls back to synthetic
# =============================================================
OANDA_TOKEN=
OANDA_ACCOUNT=
OANDA_BASE=https://api-fxpractice.oanda.com
TWELVEDATA_KEY=

# --- MetaTrader 5 (Windows) ---
# Best option when broker APIs are blocked: reads from the LOCAL terminal, so
# no network restrictions and no request limits. Just install MT5, log in, and
# `pip install MetaTrader5`. These are optional overrides.
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
# MT5_LOGIN=
# MT5_PASSWORD=
# MT5_SERVER=

# =============================================================
#  NEWS  - RSS works with no key at all. These add coverage.
# =============================================================
# Finnhub - free tier, also serves as economic calendar fallback
#   https://finnhub.io/register
FINNHUB_KEY=

# The economic calendar needs NO key - it uses ForexFactory's public JSON.

# Set to 0 in production so provider failures raise instead of serving fake data
ALLOW_SYNTHETIC=1

# Allow signals from synthetic data (development only)
DEV_ALLOW_SYNTHETIC_SIGNALS=0

# =============================================================
#  TRADINGVIEW WEBHOOK
# =============================================================
# Any random string. Must match the ?secret= in your alert URL.
TRADINGVIEW_WEBHOOK_SECRET=
