name: Deploy to Hetzner

on:
  push:
    branches: [main]          # auto-deploys every time you push to main
  workflow_dispatch:          # manual trigger from GitHub Actions tab

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Deploy via SSH
        uses: appleboy/ssh-action@v1.0.3
        with:
          host: ${{ secrets.HETZNER_HOST }}
          username: ${{ secrets.HETZNER_USER }}
          key: ${{ secrets.HETZNER_SSH_KEY }}
          port: 22
          script: |
            set -e
            echo "=== Pulling latest code ==="
            cd /root/terminal-ai
            git pull origin main

            echo "=== Installing new packages (if any) ==="
            grep -v -i "MetaTrader5" requirements.txt > /tmp/req.txt
            pip3 install -r /tmp/req.txt --break-system-packages -q

            echo "=== Restarting service ==="
            supervisorctl restart zoqira

            echo "=== Health check ==="
            sleep 5
            curl -sf https://api.realflylink.com//health > /dev/null && echo "OK" || echo "FAILED - check logs"
