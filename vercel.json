{
  "version": 2,
  "builds": [
    { "src": "static/index.html", "use": "@vercel/static" },
    { "src": "static/sw.js", "use": "@vercel/static" },
    { "src": "static/manifest.webmanifest", "use": "@vercel/static" },
    { "src": "static/*.png", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/sw.js",
      "dest": "/static/sw.js",
      "headers": {
        "Service-Worker-Allowed": "/",
        "Cache-Control": "no-cache",
        "Content-Type": "application/javascript"
      }
    },
    {
      "src": "/manifest.webmanifest",
      "dest": "/static/manifest.webmanifest",
      "headers": { "Content-Type": "application/manifest+json" }
    },
    { "src": "/(icon-192|icon-512|icon-maskable-512|apple-touch-icon)\\.png",
      "dest": "/static/$1.png",
      "headers": { "Cache-Control": "public, max-age=86400" } },
    { "src": "/(.*)", "dest": "/static/index.html" }
  ]
}
